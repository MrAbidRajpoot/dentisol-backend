# Gmail SMTP Configuration
# EMAIL_USER: Your Gmail address (e.g., info.dentisol@gmail.com)
EMAIL_USER=info.dentisol@gmail.com

# EMAIL_PASS: Gmail App Password (NOT your regular Gmail password)
# See setup instructions below for how to generate an App Password
EMAIL_PASS=your_gmail_app_password_here

# Email Configuration
# The email address that will receive contact form submissions
RECIPIENT_EMAIL=info.dentisol@gmail.com

# The name that will appear as the sender
FROM_NAME=Dentisol Contact Form

# Frontend URL (for CORS)
# Update this to your production frontend URL when deploying
FRONTEND_URL=http://localhost:3000

# Server Port (optional, defaults to 5000)
PORT=5000

# ============================================
# Gmail App Password Setup Instructions:
# ============================================
# 1. Go to your Google Account: https://myaccount.google.com
# 2. Click on "Security" in the left sidebar
# 3. Under "Signing in to Google", enable "2-Step Verification" if not already enabled
# 4. After enabling 2-Step Verification, go back to Security
# 5. Under "Signing in to Google", click on "App passwords"
# 6. Select "Mail" as the app and "Other (Custom name)" as the device
# 7. Enter "Dentisol Backend" as the custom name
# 8. Click "Generate"
# 9. Copy the 16-character password (spaces don't matter)
# 10. Paste it in EMAIL_PASS above (you can include or remove spaces)
