# Brevo SMTP Configuration
# BREVO_SMTP_USER: Your Brevo account email address
BREVO_SMTP_USER=your_brevo_email@example.com

# BREVO_SMTP_KEY: Your Brevo SMTP API key
# Get this from: Brevo Dashboard  Settings  SMTP & API  SMTP
BREVO_SMTP_KEY=your_brevo_smtp_key_here

# Email Configuration
# The email address that will receive contact form submissions
RECIPIENT_EMAIL=info.dentisol@gmail.com

# The email address that will appear as the sender
# IMPORTANT: This email must be verified in your Brevo account
FROM_EMAIL=info.dentisol@gmail.com

# The name that will appear as the sender
FROM_NAME=Dentisol Contact Form

# Frontend URL (for CORS)
# Update this to your production frontend URL when deploying
FRONTEND_URL=http://localhost:3000

# Server Port (optional, defaults to 5000)
PORT=5000

# ============================================
# Brevo SMTP Setup Instructions:
# ============================================
# 1. Sign up for a free Brevo account at https://www.brevo.com
# 2. Go to Settings  SMTP & API  SMTP
# 3. Copy your SMTP Server, Port, and Login
# 4. Generate an SMTP Key (if you don't have one)
# 5. Verify your sender email address in Brevo
# 6. Add credentials to this .env file
#
# Free tier: 300 emails/day
# SMTP Settings:
#   Host: smtp-relay.brevo.com
#   Port: 587 (TLS) or 465 (SSL)
#   Login: Your Brevo account email
#   Password: Your SMTP key
